{
  "name": "convoxos",
  "version": "0.9.0",
  "private": true,
  "description": "ConvoxOS — a CRM/operations platform with a unified Inbox. WhatsApp is the existing core channel; Telegram is the first external channel module.",
  "license": "MIT",
  "author": "Faizan Khan",
  "homepage": "https://github.com/FAIZANKHAN10X/ConvoxOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FAIZANKHAN10X/ConvoxOS.git"
  },
  "bugs": {
    "url": "https://github.com/FAIZANKHAN10X/ConvoxOS/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "telegram",
    "nextjs",
    "supabase",
    "automation",
    "broadcast",
    "self-hosted"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "graphify:update": "node scripts/update-graphify-smooth.mjs",
    "graphify:patch": "node scripts/patch-graphify-smooth.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.107.0",
    "@xyflow/react": "^12.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.30.0",
    "mammoth": "^1.12.2",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "opus-recorder": "^8.0.5",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ip-address": "^10.3.1",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "@babel/core": "^7.29.6",
    "sharp": "^0.35.3",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^5.0.0": "^5.0.9"
  }
}
